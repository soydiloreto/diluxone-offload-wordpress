msgid "Actions"
msgstr "Azioni"

#: templates/admin-sync.php:177
msgid "Continue Sync"
msgstr "Continua sincronizzazione"

#. translators: 1: number of files already synced, 2: number of files pending
#: templates/admin-sync.php:183
#, php-format
msgid ""
"Resume synchronization. You have %1$d files already synced and %2$d files "
