msgid "Connection error. Please try again."
msgstr "Erreur de connexion. Veuillez réessayer."

#: templates/admin-sync.php:3741
msgid "Max retries exceeded. Please try again later."
msgstr "Nombre maximal de tentatives dépassé. Veuillez réessayer plus tard."

#: templates/admin-sync.php:3815
msgid ""
"DEV MODE: Enable offloading without syncing files? This assumes cloud "
"already has all files."
msgstr ""
"MODE DEV : activer l'offloading sans synchroniser les fichiers ? Cela "
"suppose que le cloud contient déjà tous les fichiers."

#: templates/admin-sync.php:3832
msgid "DEV MODE: Offloading enabled without sync!"
msgstr "MODE DEV : offloading activé sans synchronisation !"

#: templates/admin-sync.php:3849
msgid ""
"DEV MODE: Disconnect without downloading files? This assumes local already "
"has all files."
msgstr ""
"MODE DEV : se déconnecter sans télécharger les fichiers ? Cela suppose que "
"le serveur local contient déjà tous les fichiers."

#: templates/admin-sync.php:3866
msgid "DEV MODE: Offloading disabled without sync!"
msgstr "MODE DEV : offloading désactivé sans synchronisation !"

